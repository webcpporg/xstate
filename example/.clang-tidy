# Example sources inherit the superproject's configuration and switch off
# one option.
#
# bugprone-exception-escape.CheckMain treats every example's main as a
# function that should not throw. An example is a short program that calls
# boost::json::parse and the libraries' own throwing accessors directly, the
# way Boost's own examples do (Boost.JSON's example directory), and lets an
# uncaught exception end the process; that is main's ordinary role, not a
# defect. The check stays on for everything else a main does not reach: a
# noexcept function, a destructor, a move or a swap.
---
InheritParentConfig: true
CheckOptions:
  # An example's main lets boost::json::parse and the libraries' own
  # throwing accessors end the process uncaught, Boost's own idiom.
  - key: bugprone-exception-escape.CheckMain
    value: 'false'
