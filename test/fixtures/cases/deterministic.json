{
  "source": "deterministic.test.ts",
  "cases": [
    {
      "name": "transitions based on an event-like object",
      "test": "deterministic.test.ts > deterministic machine > machine transitions > should properly transition states based on event-like object",
      "machine": {
        "initial": "green",
        "states": {
          "green": {
            "on": {
              "TIMER": "yellow",
              "POWER_OUTAGE": "red"
            }
          },
          "yellow": {
            "on": {
              "TIMER": "red",
              "POWER_OUTAGE": "red"
            }
          },
          "red": {
            "on": {
              "TIMER": "green",
              "POWER_OUTAGE": "red"
            },
            "initial": "walk",
            "states": {
              "walk": {
                "on": {
                  "PED_COUNTDOWN": "wait",
                  "TIMER": {}
                }
              },
              "wait": {
                "on": {
                  "PED_COUNTDOWN": "stop",
                  "TIMER": {}
                }
              },
              "stop": {}
            }
          }
        }
      },
      "steps": [
        {
          "resolve": "green"
        },
        {
          "send": {
            "type": "TIMER"
          }
        }
      ]
    },
    {
      "name": "does not transition for illegal transitions",
      "test": "deterministic.test.ts > deterministic machine > machine transitions > should not transition states for illegal transitions",
      "machine": {
        "initial": "a",
        "states": {
          "a": {
            "on": {
              "NEXT": "b"
            }
          },
          "b": {}
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "FAKE"
          }
        }
      ]
    },
