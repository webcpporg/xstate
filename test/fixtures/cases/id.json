{
  "source": "id.test.ts",
  "cases": [
    {
      "name": "from A, NEXT goes to A bar",
      "test": "id.test.ts > State node IDs > should go from A to {\"A\":\"bar\"} on NEXT",
      "machine": {
        "initial": "A",
        "states": {
          "A": {
            "id": "A",
            "initial": "foo",
            "states": {
              "foo": { "id": "A_foo", "on": { "NEXT": "#A_bar" } },
              "bar": { "id": "A_bar", "on": { "NEXT": "#B_foo" } }
            },
            "on": { "NEXT_DOT_RESOLVE": "#B.bar" }
          },
          "B": {
            "id": "B",
            "initial": "foo",
            "states": {
              "foo": { "id": "B_foo", "on": { "NEXT": "#B_bar", "NEXT_DOT": "#B.dot" } },
              "bar": { "id": "B_bar", "on": { "NEXT": "#A_foo" } },
              "dot": {}
            }
          }
        }
      },
      "steps": [
        { "resolve": "A" },
        { "send": { "type": "NEXT" } }
      ]
    },
    {
      "name": "from A, NEXT_DOT_RESOLVE goes to B bar",
      "test": "id.test.ts > State node IDs > should go from A to {\"B\":\"bar\"} on NEXT_DOT_RESOLVE",
      "machine": {
        "initial": "A",
        "states": {
          "A": {
            "id": "A",
            "initial": "foo",
            "states": {
              "foo": { "id": "A_foo", "on": { "NEXT": "#A_bar" } },
              "bar": { "id": "A_bar", "on": { "NEXT": "#B_foo" } }
            },
            "on": { "NEXT_DOT_RESOLVE": "#B.bar" }
          },
          "B": {
            "id": "B",
            "initial": "foo",
            "states": {
              "foo": { "id": "B_foo", "on": { "NEXT": "#B_bar", "NEXT_DOT": "#B.dot" } },
              "bar": { "id": "B_bar", "on": { "NEXT": "#A_foo" } },
              "dot": {}
            }
          }
        }
      },
      "steps": [
        { "resolve": "A" },
        { "send": { "type": "NEXT_DOT_RESOLVE" } }
      ]
    },
    {
      "name": "from A.foo, NEXT goes to A bar",
      "test": "id.test.ts > State node IDs > should go from {\"A\":\"foo\"} to {\"A\":\"bar\"} on NEXT",
      "machine": {
        "initial": "A",
        "states": {
          "A": {
            "id": "A",
            "initial": "foo",
            "states": {
              "foo": { "id": "A_foo", "on": { "NEXT": "#A_bar" } },
              "bar": { "id": "A_bar", "on": { "NEXT": "#B_foo" } }
            },
            "on": { "NEXT_DOT_RESOLVE": "#B.bar" }
          },
          "B": {
            "id": "B",
            "initial": "foo",
            "states": {
              "foo": { "id": "B_foo", "on": { "NEXT": "#B_bar", "NEXT_DOT": "#B.dot" } },
              "bar": { "id": "B_bar", "on": { "NEXT": "#A_foo" } },
              "dot": {}
            }
          }
        }
      },
      "steps": [
        { "resolve": { "A": "foo" } },
        { "send": { "type": "NEXT" } }
      ]
    },
    {
      "name": "from A.bar, NEXT goes to B foo",
      "test": "id.test.ts > State node IDs > should go from {\"A\":\"bar\"} to {\"B\":\"foo\"} on NEXT",
      "machine": {
        "initial": "A",
        "states": {
          "A": {
            "id": "A",
            "initial": "foo",
            "states": {
              "foo": { "id": "A_foo", "on": { "NEXT": "#A_bar" } },
              "bar": { "id": "A_bar", "on": { "NEXT": "#B_foo" } }
            },
            "on": { "NEXT_DOT_RESOLVE": "#B.bar" }
          },
          "B": {
            "id": "B",
            "initial": "foo",
            "states": {
              "foo": { "id": "B_foo", "on": { "NEXT": "#B_bar", "NEXT_DOT": "#B.dot" } },
              "bar": { "id": "B_bar", "on": { "NEXT": "#A_foo" } },
              "dot": {}
