            },
            "states": {
              "b1": {},
              "b2": {
                "id": "hist",
                "type": "history"
              }
            }
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "NEXT"
          }
        }
      ]
    },
