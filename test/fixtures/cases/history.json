      "name": "entering the default history configuration does not enter ancestors outside the transition domain",
      "test": "history.test.ts > history states > should not enter ancestors of the entered history state that lie outside of the transition domain when entering the default history configuration",
      "machine": {
        "initial": "closed",
        "states": {
          "closed": {
            "exit": "exit_closed",
            "on": {
              "BUTTON.CLICK": "open.hist"
            }
          },
          "open": {
            "entry": "enter_open",
            "on": {
              "BUTTON.CLICK": "closed"
            },
            "initial": "first",
            "states": {
              "hist": {
                "type": "history"
              },
              "first": {
                "entry": "enter_open_first"
              },
              "second": {}
            }
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "BUTTON.CLICK"
          }
        }
      ]
    },
    {
      "name": "restoring the stored history configuration does not enter ancestors outside the transition domain",
      "test": "history.test.ts > history states > should not enter ancestors of the entered history state that lie outside of the transition domain when restoring the stored history configuration",
      "machine": {
        "initial": "closed",
        "states": {
          "closed": {
            "id": "closed",
            "exit": "exit_closed",
            "on": {
              "BUTTON.CLICK": "open.hist"
            }
          },
          "open": {
            "entry": "enter_open",
            "on": {
              "BUTTON.CLICK": "closed"
            },
            "initial": "first",
            "states": {
              "hist": {
                "type": "history"
              },
              "first": {
                "entry": "enter_open_first",
                "on": {
                  "NEXT": "second"
                }
              },
              "second": {
                "entry": "enter_open_second",
                "on": {
                  "CLOSE": "#closed"
                }
              }
            }
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "BUTTON.CLICK"
          }
        },
        {
          "send": {
            "type": "NEXT"
          }
        },
        {
          "send": {
            "type": "CLOSE"
          }
        },
        {
          "send": {
            "type": "BUTTON.CLICK"
          }
        }
      ]
