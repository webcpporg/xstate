  "cases": [
    {
      "name": "shallow history explicit, most recently visited",
      "test": "history.test.ts > history states > should go to the most recently visited state (explicit shallow history type)",
      "machine": {
        "initial": "on",
        "states": {
          "on": {
            "initial": "first",
            "states": {
              "first": {
                "on": {
                  "SWITCH": "second"
                }
              },
              "second": {},
              "hist": {
                "type": "history",
                "history": "shallow"
              }
            },
            "on": {
              "POWER": "off"
            }
          },
          "off": {
            "on": {
              "POWER": "on.hist"
            }
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "SWITCH"
          }
        },
        {
          "send": {
            "type": "POWER"
          }
        },
        {
          "send": {
            "type": "POWER"
          }
        }
      ]
    },
