    {
      "name": "history reached through a transient transition",
      "test": "history.test.ts > history states > should go to the most recently visited state by a transient transition",
      "machine": {
        "initial": "idle",
        "states": {
          "idle": {
            "id": "idle",
            "initial": "absent",
            "states": {
              "absent": {
                "on": {
                  "DEPLOY": "#deploy"
                }
              },
              "present": {
                "on": {
                  "DEPLOY": "#deploy",
                  "DESTROY": "#destroy"
                }
              },
              "hist": {
                "type": "history"
              }
            }
          },
          "deploy": {
            "id": "deploy",
            "on": {
              "SUCCESS": "idle.present",
              "FAILURE": "idle.hist"
            }
          },
          "destroy": {
            "id": "destroy",
            "always": [
              {
                "target": "idle.absent"
              }
            ]
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "DEPLOY"
          }
        },
        {
          "send": {
            "type": "SUCCESS"
          }
        },
        {
          "send": {
            "type": "DESTROY"
          }
        },
        {
          "send": {
            "type": "DEPLOY"
          }
        },
        {
          "send": {
            "type": "FAILURE"
          }
        }
      ]
    },
    {
      "name": "reentering transition targeting a history state reenters persisted state",
      "test": "history.test.ts > history states > should reenter persisted state during reentering transition targeting a history state",
      "machine": {
        "initial": "a",
        "states": {
          "a": {
            "on": {
              "REENTER": {
                "target": "#b_hist",
                "reenter": true
              }
            },
            "initial": "a1",
            "states": {
              "a1": {
                "on": {
                  "NEXT": "a2"
                }
              },
              "a2": {
                "entry": "enter_a2",
                "exit": "exit_a2"
              },
              "a3": {
                "type": "history",
                "id": "b_hist"
              }
            }
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "NEXT"
          }
        },
        {
          "send": {
            "type": "REENTER"
          }
        }
      ]
    },
