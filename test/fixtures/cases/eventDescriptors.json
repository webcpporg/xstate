  "excluded": [
    {
      "test": "eventDescriptors.test.ts > event descriptors > should throw if assertEvent partial descriptor does not match",
      "reason": "calls assertEvent directly on an event object, outside any machine or actor, and asserts the error it throws; no case runs assertEvent, and no vocabulary entry asserts an event against a descriptor. It would need an assertEvent entry (an action or guard that fails when the event does not match a descriptor) in both vocabularies, and even then a case would show only a failed status, not the message the test snapshots"
    }
  ]
