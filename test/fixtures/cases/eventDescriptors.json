{
  "source": "eventDescriptors.test.ts",
  "cases": [
    {
      "name": "wildcard fallback when no exact match",
      "test": "eventDescriptors.test.ts > event descriptors > should fallback to using wildcard transition definition (if specified)",
      "machine": {
        "initial": "A",
        "states": {
          "A": {
            "on": {
              "FOO": "B",
              "*": "C"
            }
          },
          "B": {},
          "C": {}
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "BAR"
          }
        },
        {
          "query": {
            "matches": "C"
          }
        }
      ]
    },
    {
      "name": "explicit descriptor over leading wildcard",
      "test": "eventDescriptors.test.ts > event descriptors > should prioritize explicit descriptor even if wildcard comes first",
      "machine": {
        "initial": "A",
        "states": {
          "A": {
            "on": {
              "*": "fail",
              "NEXT": "pass"
            }
          },
          "fail": {},
          "pass": {}
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "NEXT"
          }
        },
        {
          "query": {
            "matches": "pass"
          }
        }
      ]
    },
    {
      "name": "explicit descriptor over leading partial wildcard",
      "test": "eventDescriptors.test.ts > event descriptors > should prioritize explicit descriptor even if a partial one comes first",
      "machine": {
        "initial": "A",
        "states": {
          "A": {
            "on": {
              "foo.*": "fail",
              "foo.bar": "pass"
            }
          },
          "fail": {},
          "pass": {}
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "foo.bar"
          }
        },
        {
          "query": {
            "matches": "pass"
          }
        }
      ]
    },
    {
      "name": "longer descriptor over leading shorter one",
      "test": "eventDescriptors.test.ts > event descriptors > should prioritize a longer descriptor even if the shorter one comes first",
      "machine": {
        "initial": "A",
        "states": {
          "A": {
            "on": {
              "foo.*": "fail",
              "foo.bar.*": "pass"
            }
          },
          "fail": {},
          "pass": {}
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "foo.bar.baz"
          }
        },
        {
          "query": {
            "matches": "pass"
          }
        }
      ]
    },
    {
      "name": "shorter descriptor when longer one fails its guard",
      "test": "eventDescriptors.test.ts > event descriptors > should use a shorter descriptor if the longer one doesn't match",
      "machine": {
        "initial": "A",
        "states": {
          "A": {
            "on": {
              "foo.bar.*": {
                "target": "fail",
                "guard": {
                  "type": "context_equals",
                  "params": {
                    "key": "__never__",
                    "value": "__false__"
                  }
                }
              },
              "foo.*": "pass"
            }
          },
          "fail": {},
          "pass": {}
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "foo.bar.baz"
          }
        },
        {
          "query": {
            "matches": "pass"
          }
        }
      ]
    },
    {
      "name": "wildcard fallback when exact descriptor guard fails",
      "test": "eventDescriptors.test.ts > event descriptors > should fall back to wildcard descriptor when exact descriptor guard fails",
      "machine": {
        "initial": "A",
        "states": {
          "A": {
            "on": {
              "foo.bar": {
                "guard": {
                  "type": "context_equals",
                  "params": {
                    "key": "__never__",
                    "value": "__false__"
                  }
                },
                "target": "fail"
              },
              "foo.*": "pass"
            }
          },
          "fail": {},
          "pass": {}
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "foo.bar"
          }
        },
        {
          "query": {
            "matches": "pass"
          }
        }
      ]
    },
