    {
      "name": "exit all substates when superstate exits",
      "test": "deep.test.ts > deep transitions > exiting super/substates > should exit all substates when superstates exits",
      "machine": {
        "id": "root",
        "initial": "A",
        "states": {
          "DONE": {
            "entry": "enter: DONE"
          },
          "FAIL": {},
          "A": {
            "on": {
              "A_EVENT": "#root.DONE"
            },
            "exit": "exit: A",
            "initial": "B",
            "states": {
              "B": {
                "exit": "exit: A.B",
                "initial": "C",
                "states": {
                  "C": {
                    "exit": "exit: A.B.C",
                    "initial": "D",
                    "states": {
                      "D": {
                        "exit": "exit: A.B.C.D"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "A_EVENT"
          }
        }
      ]
    },
