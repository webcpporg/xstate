{
  "source": "stateIn.test.ts",
  "cases": [
    {
      "name": "stateIn object form matches sibling",
      "test": "stateIn.test.ts > transition \"in\" check > should transition if string state path matches current state value",
      "machine": {
        "type": "parallel",
        "states": {
          "a": {
            "initial": "a1",
            "states": {
              "a1": {
                "on": {
                  "EVENT2": {
                    "target": "a2",
                    "guard": { "type": "xstate.stateIn", "stateValue": { "b": "b2" } }
                  }
                }
              },
              "a2": { "id": "a_a2" }
            }
          },
          "b": {
            "initial": "b2",
            "states": {
              "b1": {
                "on": {
                  "EVENT": { "target": "b2", "guard": { "type": "xstate.stateIn", "stateValue": "#a_a2" } }
                }
              },
              "b2": {
                "id": "b_b2",
                "type": "parallel",
                "states": {
                  "foo": { "initial": "foo2", "states": { "foo1": {}, "foo2": {} } },
                  "bar": { "initial": "bar1", "states": { "bar1": { "id": "bar1" }, "bar2": {} } }
                }
              }
            }
          }
        }
      },
      "steps": [{ "start": true }, { "send": { "type": "EVENT2" } }]
    },
    {
