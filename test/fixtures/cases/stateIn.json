    {
      "name": "stateIn forbids events until matching nested state",
      "test": "stateIn.test.ts > transition \"in\" check > should work to forbid events",
      "machine": {
        "initial": "green",
        "states": {
          "green": { "on": { "TIMER": "yellow" } },
          "yellow": { "on": { "TIMER": "red" } },
          "red": {
            "initial": "walk",
            "states": {
              "walk": { "on": { "TIMER": "wait" } },
              "wait": { "on": { "TIMER": "stop" } },
              "stop": {}
            },
            "on": {
              "TIMER": [
                {
                  "target": "green",
                  "guard": { "type": "xstate.stateIn", "stateValue": { "red": "stop" } }
                }
              ]
            }
          }
        }
      },
      "steps": [
        { "start": true },
        { "send": { "type": "TIMER" } },
        { "send": { "type": "TIMER" } },
        { "send": { "type": "TIMER" } },
        { "send": { "type": "TIMER" } },
        { "send": { "type": "TIMER" } }
      ]
    },
    {
      "name": "stateIn referenced by name over sibling",
      "test": "stateIn.test.ts > transition \"in\" check > should be possible to use a referenced `stateIn` guard",
      "machine": {
        "type": "parallel",
        "states": {
          "selected": {},
          "location": {
            "initial": "home",
            "states": {
              "home": {
                "on": {
                  "NEXT": {
                    "target": "success",
                    "guard": { "type": "xstate.stateIn", "stateValue": "selected" }
                  }
                }
              },
              "success": {}
            }
          }
        }
      },
      "steps": [{ "start": true }, { "send": { "type": "NEXT" } }]
    },
    {
      "name": "stateIn with id and path runs action",
      "test": "stateIn.test.ts > transition \"in\" check > should be possible to check an ID with a path",
      "machine": {
        "type": "parallel",
        "states": {
          "A": {
            "initial": "A1",
            "states": {
              "A1": {
                "on": {
                  "MY_EVENT": {
                    "guard": { "type": "xstate.stateIn", "stateValue": "#b.B1" },
                    "actions": "hit"
                  }
                }
              }
            }
          },
          "B": {
            "id": "b",
            "initial": "B1",
            "states": { "B1": {} }
          }
        }
      },
      "steps": [{ "start": true }, { "send": { "type": "MY_EVENT" } }]
