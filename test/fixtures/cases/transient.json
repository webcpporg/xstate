    {
      "name": "all raised internal events execute one after the other",
      "test": "transient.test.ts > transient states (eventless transitions) > should execute all internal events one after the other",
      "machine": {
        "type": "parallel",
        "states": {
          "A": {
            "initial": "A1",
            "states": {
              "A1": {
                "on": {
                  "E": "A2"
                }
              },
              "A2": {
                "entry": "raiseInt1"
              }
            }
          },
          "B": {
            "initial": "B1",
            "states": {
              "B1": {
                "on": {
                  "E": "B2"
                }
              },
              "B2": {
                "entry": "raiseInt2"
              }
            }
          },
          "C": {
            "initial": "C1",
            "states": {
              "C1": {
                "on": {
                  "INT1": "C2",
                  "INT2": "C3"
                }
              },
              "C2": {
                "on": {
                  "INT2": "C4"
                }
              },
              "C3": {
                "on": {
                  "INT1": "C4"
                }
              },
              "C4": {}
            }
          }
        }
      },
      "actions": {
        "raiseInt1": {
          "kind": "raise",
          "event": {
            "type": "INT1"
          }
        },
        "raiseInt2": {
          "kind": "raise",
          "event": {
            "type": "INT2"
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "E"
          }
        }
      ]
    },
