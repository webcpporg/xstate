  "excluded": [
    {
      "test": "transient.test.ts > transient states (eventless transitions) > shouldn't crash when invoking a machine with initial transient transition depending on custom data",
      "reason": "ported with the actor cases, fixtures/actors/cases/transient.json"
    },
    {
      "test": "transient.test.ts > transient states (eventless transitions) > should avoid infinite loops with eventless transitions",
      "reason": "the a -> b -> c -> a cycle of eventless transitions is stopped only by XState's options.maxIterations (100 here; its default is Infinity, so without it XState never returns from start), and xstate has no such bound by design: a cycle never settles and the caller's fuel is the only bound (doc: #xstate-invariant-8), so its case harness writes unsettled_after where XState writes the start step's error. It would need a maxIterations option in xstate's machine config that fails the macrostep with an error code of its own"
    },
    {
      "test": "transient.test.ts > transient states (eventless transitions) > should avoid infinite loops with raised events",
      "reason": "same as the eventless cycle: the a -> b (entry raise EVENT) -> c -> a cycle is stopped only by XState's options.maxIterations (100 here, Infinity by default), which xstate does not have (a cycle never settles and the caller's fuel is the only bound, doc: #xstate-invariant-8). It would need a maxIterations option in xstate's machine config that fails the macrostep with an error code of its own"
    }
  ]
}
