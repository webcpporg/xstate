{
  "source": "transient.test.ts",
  "cases": [
    {
      "name": "first candidate guard matches, data false (1)",
      "test": "transient.test.ts > transient states (eventless transitions) > should choose the first candidate target that matches the guard 1",
      "machine": {
        "context": {
          "data": false
        },
        "initial": "G",
        "states": {
          "G": {
            "on": {
              "UPDATE_BUTTON_CLICKED": "E"
            }
          },
          "E": {
            "always": [
              {
                "target": "D",
                "guard": {
                  "type": "context_equals",
                  "params": {
                    "key": "data",
                    "value": false
                  }
                }
              },
              {
                "target": "F"
              }
            ]
          },
          "D": {},
          "F": {}
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "UPDATE_BUTTON_CLICKED"
          }
        }
      ]
    },
