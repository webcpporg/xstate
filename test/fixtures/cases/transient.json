    {
      "name": "preserves the triggering event in an eventless transition's actions",
      "test": "transient.test.ts > transient states (eventless transitions) > events that trigger eventless transitions should be preserved in actions (each action's expect on the event as a push of {action, event} into context.seen, so that expect.assertions(3) shows as exactly one entry per action)",
      "machine": {
        "initial": "a",
        "context": {
          "seen": []
        },
        "states": {
          "a": {
            "on": {
              "EVENT": "b"
            }
          },
          "b": {
            "always": {
              "target": "c",
              "actions": {
                "type": "push",
                "params": {
                  "key": "seen",
                  "value": {
                    "action": "always",
                    "event": {
                      "$event": ""
                    }
                  }
                }
              }
            },
            "exit": {
              "type": "push",
              "params": {
                "key": "seen",
                "value": {
                  "action": "exit",
                  "event": {
                    "$event": ""
                  }
                }
              }
            }
          },
          "c": {
            "entry": {
              "type": "push",
              "params": {
                "key": "seen",
                "value": {
                  "action": "entry",
                  "event": {
                    "$event": ""
                  }
                }
              }
            }
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "EVENT",
            "value": 42
          }
        }
      ]
    },
    {
      "name": "an always transition runs again after a raised transition that changes nothing",
      "test": "transient.test.ts > transient states (eventless transitions) > should execute an always transition after a raised transition even if that raised transition doesn't change the state (the spy as the custom action spy and the external counter's increment as the custom action incrementCounter, so that the RAISED transition changes nothing; the spy's calls [0] and [1] as spy running once in response to EV, before incrementCounter, and once in response to RAISED, after it)",
      "machine": {
        "always": {
          "actions": "spy"
        },
        "on": {
          "EV": {
            "actions": "raiseRaised"
          },
          "RAISED": {
            "actions": "incrementCounter"
          }
        }
      },
      "actions": {
        "raiseRaised": {
          "kind": "raise",
          "event": {
            "type": "RAISED"
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "EV"
          }
        }
      ]
