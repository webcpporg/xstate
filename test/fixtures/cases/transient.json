    {
      "name": "resolved initial state from the transient state",
      "test": "transient.test.ts > transient states (eventless transitions) > should determine the resolved initial state from the transient state",
      "machine": {
        "id": "greeting",
        "initial": "pending",
        "context": {
          "hour": 10
        },
        "states": {
          "pending": {
            "always": [
              {
                "target": "morning",
                "guard": {
                  "type": "xstate.not",
                  "guards": [
                    {
                      "type": "context_at_least",
                      "params": {
                        "key": "hour",
                        "value": 12
                      }
                    }
                  ]
                }
              },
              {
                "target": "afternoon",
                "guard": {
                  "type": "xstate.not",
                  "guards": [
                    {
                      "type": "context_at_least",
                      "params": {
                        "key": "hour",
                        "value": 18
                      }
                    }
                  ]
                }
              },
              {
                "target": "evening"
              }
            ]
          },
          "morning": {},
          "afternoon": {},
          "evening": {}
        },
        "on": {
          "CHANGE": {
            "actions": {
              "type": "set",
              "params": {
                "key": "hour",
                "value": 20
              }
            }
          },
          "RECHECK": "#greeting"
        }
      },
      "steps": [
        {
          "start": true
        }
      ]
    },
