    {
      "name": "carries actions across the same step",
      "test": "transient.test.ts > transient states (eventless transitions) > should carry actions from previous transitions within same step",
      "machine": {
        "initial": "A",
        "states": {
          "A": {
            "exit": "exit_A",
            "on": {
              "TIMER": {
                "target": "T",
                "actions": "timer"
              }
            }
          },
          "T": {
            "always": [
              {
                "target": "B"
              }
            ]
          },
          "B": {
            "entry": "enter_B"
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "TIMER"
          }
        }
      ]
