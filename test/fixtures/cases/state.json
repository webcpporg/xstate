    {
      "name": "can() runs no assign of the transition it finds",
      "test": "state.test.ts > State > .can > should not execute assignments when used with non-started actor (the vocabulary's failing assign stands for the assign whose side effect sets the flag: had can() run it, the query would answer \"error\", and the send after the query shows that running the assign fails the macrostep. The started test is the same case: the core's start step is the initial snapshot that createActor holds and that start() leaves unchanged)",
      "machine": {
        "context": {},
        "on": {
          "EVENT": {
            "actions": [
              {
                "type": "fail"
              }
            ]
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "query": {
            "can": {
              "type": "EVENT"
            }
          }
        },
        {
          "send": {
            "type": "EVENT"
          }
        }
      ]
    }
