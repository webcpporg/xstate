{
  "source": "state.test.ts",
  "cases": [
    {
      "name": "status is not done before reaching a final state",
      "test": "state.test.ts > State > status > should show that a machine has not reached its final state",
      "machine": {
        "initial": "one",
        "states": {
          "one": {
            "entry": "enter",
            "on": {
              "EXTERNAL": {
                "target": "one",
                "reenter": true
              },
              "INERT": {},
              "INTERNAL": {
                "actions": "doSomething"
              },
              "TO_TWO": "two",
              "TO_TWO_MAYBE": {
                "target": "two"
              },
              "TO_THREE": "three",
              "FORBIDDEN_EVENT": {},
              "TO_FINAL": "success"
            }
          },
          "two": {
            "initial": "deep",
            "states": {
              "deep": {
                "initial": "foo",
                "states": {
                  "foo": {
                    "on": {
                      "FOO_EVENT": "bar",
                      "FORBIDDEN_EVENT": {}
                    }
                  },
                  "bar": {
                    "on": {
                      "BAR_EVENT": "foo"
                    }
                  }
                }
              }
            },
            "on": {
              "DEEP_EVENT": "."
            }
          },
          "three": {
            "type": "parallel",
            "states": {
              "first": {
                "initial": "p31",
                "states": {
                  "p31": {
                    "on": {
                      "P31": "."
                    }
                  }
                }
              },
              "guarded": {
                "initial": "p32",
                "states": {
                  "p32": {
                    "on": {
                      "P32": "."
                    }
                  }
                }
              }
            },
            "on": {
              "THREE_EVENT": "."
            }
          },
          "success": {
            "type": "final"
          }
        },
        "on": {
          "MACHINE_EVENT": ".two"
        }
      },
      "steps": [
        {
          "start": true
        }
      ]
    },
