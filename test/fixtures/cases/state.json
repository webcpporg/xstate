  "excluded": [
    {
      "test": "state.test.ts > State > .can > should not spawn actors when determining if an event is accepted",
      "reason": "the test spawns a fromCallback through an assign's spawn and asserts only that the callback never ran: fromCallback is not ported (out of scope for the actor layer), the reference spawn returns into the context is an actor reference as data, and the core cases start no child, so a spawn made by can() would not show in the query's answer. fixtures/actors/cases/state.json, which the earlier reason named, does not port it: it excludes it for the same reasons and has no can() step. It would need a can() query step in the actor cases, on a running actor, beside a spawn_child of a host actor whose request would show the spawn"
    },
    {
      "test": "state.test.ts > State > .hasTag > should be able to check a tag after recreating a persisted state",
      "reason": "persistence/rehydration: creates a second actor from actorRef.getPersistedSnapshot()"
    },
    {
      "test": "state.test.ts > State > .status > should be 'stopped' after a running actor gets stopped",
      "reason": "ported with the actor cases, fixtures/actors/cases/state.json"
    }
  ]
}
