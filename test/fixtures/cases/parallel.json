        "type": "parallel",
        "states": {
          "OUTER1": {
            "initial": "STATE_OFF",
            "states": {
              "STATE_OFF": {
                "on": {
                  "EVENT_COMPLEX": "STATE_ON",
                  "EVENT_SIMPLE": "STATE_ON"
                }
              },
              "STATE_ON": {
                "type": "parallel",
                "states": {
                  "STATE_NTJ0": {
                    "initial": "STATE_IDLE_0",
                    "states": {
                      "STATE_IDLE_0": {
                        "on": {
                          "EVENT_STATE_NTJ0_WORK": "STATE_WORKING_0"
                        }
                      },
                      "STATE_WORKING_0": {
                        "on": {
                          "EVENT_STATE_NTJ0_IDLE": "STATE_IDLE_0"
