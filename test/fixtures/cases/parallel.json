                          "target": ".SelectedActivity",
                          "actions": [
                            "selectActivity"
                          ]
                        }
                      ],
                      "singleClickLink": [
                        {
                          "target": ".SelectedLink",
                          "actions": [
                            "selectLink"
                          ]
