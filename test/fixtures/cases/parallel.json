    {
      "name": "entry raise on initial state clears before external events",
      "test": "parallel.test.ts > parallel states > should properly transition according to entry events on an initial state",
      "machine": {
        "type": "parallel",
        "states": {
          "OUTER1": {
            "initial": "B",
            "states": {
              "A": {},
              "B": {
                "entry": "clear"
              }
            }
          },
          "OUTER2": {
            "type": "parallel",
            "states": {
              "INNER1": {
                "initial": "ON",
                "states": {
                  "OFF": {},
                  "ON": {
                    "on": {
                      "CLEAR": "OFF"
                    }
                  }
                }
              },
              "INNER2": {
                "initial": "OFF",
                "states": {
                  "OFF": {},
                  "ON": {}
                }
              }
            }
          }
        }
      },
      "actions": {
        "clear": {
          "kind": "raise",
          "event": {
            "type": "CLEAR"
          }
        }
      },
      "steps": [
        {
          "start": true
        }
      ]
    },
    {
      "name": "raised events settle a parallel state across regions",
      "test": "parallel.test.ts > parallel states > should properly transition when raising events for a parallel state",
      "machine": {
        "type": "parallel",
        "states": {
          "OUTER1": {
            "initial": "C",
            "states": {
              "A": {
                "entry": [
                  "turnOff"
                ],
                "on": {
                  "EVENT_OUTER1_B": "B",
                  "EVENT_OUTER1_C": "C"
                }
              },
              "B": {
                "entry": [
                  "turnOn"
                ],
                "on": {
                  "EVENT_OUTER1_A": "A",
                  "EVENT_OUTER1_C": "C"
                }
              },
              "C": {
                "entry": [
                  "clearR"
                ],
                "on": {
                  "EVENT_OUTER1_A": "A",
                  "EVENT_OUTER1_B": "B"
                }
              }
            }
          },
          "OUTER2": {
            "type": "parallel",
            "states": {
              "INNER1": {
                "initial": "ON",
                "states": {
                  "OFF": {
                    "on": {
                      "TURN_ON": "ON"
                    }
                  },
                  "ON": {
                    "on": {
                      "CLEAR": "OFF"
                    }
                  }
                }
              },
              "INNER2": {
                "initial": "OFF",
                "states": {
                  "OFF": {
                    "on": {
                      "TURN_ON": "ON"
                    }
                  },
                  "ON": {
                    "on": {
                      "TURN_OFF": "OFF"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "actions": {
        "turnOff": {
          "kind": "raise",
          "event": {
            "type": "TURN_OFF"
          }
        },
        "turnOn": {
          "kind": "raise",
          "event": {
            "type": "TURN_ON"
          }
        },
        "clearR": {
          "kind": "raise",
          "event": {
            "type": "CLEAR"
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "EVENT_OUTER1_B"
          }
        }
      ]
    },
