    {
      "name": "states may omit meta",
      "test": "meta.test.ts > state meta data > should allow states to omit meta",
      "machine": {
        "initial": "a",
        "states": {
          "a": {
            "meta": {
              "layout": "a-layout"
            }
          },
          "c": {}
