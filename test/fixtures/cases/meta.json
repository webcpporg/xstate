    {
      "name": "the definition keeps the meta of the initial, delayed and invoke transitions",
      "test": "meta.test.ts > transition meta data > preserves transition meta on all transition definitions (the meta of the initial transition, of the delayed one and of the invoke's onDone, onError and onSnapshot, as the definition holds them; the eventless transition's meta is not ported, as XState's definition leaves out the eventless transitions and the record's transitions carry no meta; the child machine stands as a host actor, of which the definition holds only the src; the satisfies checks and the @ts-expect-error on the invoke's transition meta are TypeScript's type checker)",
      "machine": {
        "initial": {
          "target": "idle",
          "meta": {
            "source": "initial"
          }
        },
        "states": {
          "idle": {
            "always": {
              "meta": {
                "source": "always"
              }
            },
            "after": {
              "100": {
                "meta": {
                  "source": "after"
                }
              }
            },
            "invoke": {
              "src": "child",
              "onDone": {
                "meta": {
                  "source": "invoke.done"
                }
              },
              "onError": {
                "meta": {
                  "source": "invoke.error"
                }
              },
              "onSnapshot": {
                "meta": {
                  "source": "invoke.snapshot"
                }
              }
            }
          }
        }
      },
      "actors": {
        "child": {
          "kind": "host"
        }
      },
      "steps": []
    },
    {
      "name": "the definition keeps a state's description",
      "test": "meta.test.ts > state description > state node should have its description",
      "machine": {
        "initial": "test",
        "states": {
          "test": {
            "description": "This is a test"
          }
        }
      },
      "steps": []
    },
    {
      "name": "the definition keeps a transition's description",
      "test": "meta.test.ts > transition description > state node should have its description",
      "machine": {
        "on": {
          "EVENT": {
            "description": "This is a test"
          }
        }
      },
      "steps": []
    }
