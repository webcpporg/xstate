{
  "source": "assign.test.ts",
  "cases": [
    {
      "name": "decrement twice (property assignment)",
      "test": "assign.test.ts > assign > applies the assignment to the external state (property assignment)",
      "machine": {
        "initial": "counting",
        "context": {
          "count": 0,
          "foo": "bar"
        },
        "states": {
          "counting": {
            "on": {
              "INC": {
                "target": "counting",
                "actions": {
                  "type": "increment",
                  "params": {
                    "key": "count",
                    "by": 1
                  }
                }
              },
              "DEC": {
                "target": "counting",
                "actions": {
                  "type": "increment",
                  "params": {
                    "key": "count",
                    "by": -1
                  }
                }
              },
              "WIN_PROP": {
                "target": "counting",
                "actions": [
                  {
                    "type": "set",
                    "params": {
                      "key": "count",
                      "value": 100
                    }
                  },
                  {
                    "type": "set",
                    "params": {
                      "key": "foo",
                      "value": "win"
                    }
                  }
                ]
              },
              "WIN_STATIC": {
                "target": "counting",
                "actions": [
                  {
                    "type": "set",
                    "params": {
                      "key": "count",
                      "value": 100
                    }
                  },
                  {
                    "type": "set",
                    "params": {
                      "key": "foo",
                      "value": "win"
                    }
                  }
                ]
              },
              "WIN_MIX": {
                "target": "counting",
                "actions": [
                  {
                    "type": "set",
                    "params": {
                      "key": "count",
                      "value": 100
                    }
                  },
                  {
                    "type": "set",
                    "params": {
                      "key": "foo",
                      "value": "win"
                    }
                  }
                ]
              },
              "WIN": {
                "target": "counting",
                "actions": [
                  {
                    "type": "set",
                    "params": {
                      "key": "count",
                      "value": 100
                    }
                  },
                  {
                    "type": "set",
                    "params": {
                      "key": "foo",
                      "value": "win"
                    }
                  }
                ]
              },
              "SET_MAYBE": {
                "actions": [
                  {
                    "type": "set",
                    "params": {
                      "key": "maybe",
                      "value": "defined"
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "DEC"
          }
        },
        {
          "send": {
            "type": "DEC"
          }
        }
      ]
