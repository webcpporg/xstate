    {
      "test": "assign.test.ts > assign meta > a parameterized action that resolves to assign() should be provided the params",
      "reason": "the test is itself async (it returns a promise resolved from inside the assigner) and the assigner only inspects params and returns context unchanged; no vocabulary assign expresses a no-op check-only assigner, and the synchronous case format has no way to await a resolver"
    }
