          }
        }
      },
      "actors": {
        "child": {
          "kind": "host"
        }
      },
      "delays": {
        "short": 10
      },
      "actions": {
        "send_later": {
          "kind": "send_to",
          "target": "kid",
          "event": {
            "type": "LATER"
          },
          "id": "later",
          "delay": 100
        },
        "send_named": {
          "kind": "send_to",
          "target": "kid",
          "event": {
            "type": "NAMED"
          },
          "delay": "short"
        },
        "send_unknown": {
          "kind": "send_to",
          "target": "kid",
          "event": {
            "type": "NOW"
          },
          "delay": "unknown"
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "PING"
          }
        }
      ]
    },
