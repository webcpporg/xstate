{
  "source": "actions that name actors, through the pure functions",
  "cases": [
    {
      "name": "spawnChild adds a child, stopChild removes it",
      "test": "actions/spawnChild.ts resolveSpawn and actions/stopChild.ts resolveStop",
      "machine": {
        "id": "m",
        "initial": "a",
        "states": {
          "a": {
            "on": {
              "SPAWN": {
                "actions": [
                  "spawn_kid"
                ]
              },
              "STOP": {
                "actions": [
                  "stop_kid"
                ]
              }
            }
          }
        }
      },
      "actors": {
        "child": {
          "kind": "host"
        }
      },
      "actions": {
        "spawn_kid": {
          "kind": "spawn_child",
          "src": "child",
          "id": "kid",
          "input": {
            "n": 1
          }
        },
        "stop_kid": {
          "kind": "stop_child",
          "id": "kid"
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "SPAWN"
          }
        },
        {
          "send": {
            "type": "STOP"
          }
        },
        {
          "send": {
            "type": "STOP"
          }
        }
      ]
    },
    {
      "name": "spawnChild's input is read from the context as the earlier actions left it",
      "test": "actions/spawnChild.ts resolveSpawn: input({context, event, self})",
      "machine": {
        "id": "m",
        "context": {
          "n": 0
        },
        "initial": "a",
        "states": {
          "a": {
            "on": {
              "SPAWN": {
                "actions": [
                  {
                    "type": "set",
                    "params": {
                      "key": "n",
                      "value": 5
                    }
                  },
                  "spawn_kid"
                ]
              }
            }
          }
        }
      },
      "actors": {
        "child": {
          "kind": "host"
        }
      },
      "actions": {
        "spawn_kid": {
          "kind": "spawn_child",
          "src": "child",
          "id": "kid",
          "systemId": "worker",
          "input_from_context": "n"
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "SPAWN"
          }
        }
      ]
    },
    {
      "name": "spawnChild under an id already there replaces the child in place",
      "test": "actions/spawnChild.ts resolveSpawn: {...snapshot.children, [resolvedId]: actorRef}",
      "machine": {
        "id": "m",
        "initial": "a",
        "states": {
          "a": {
            "invoke": [
              {
                "src": "child",
                "id": "first"
              },
              {
                "src": "child",
                "id": "kid"
              }
            ],
            "on": {
              "AGAIN": {
                "actions": [
                  "spawn_other"
                ]
              }
            }
          }
        }
      },
      "actors": {
        "child": {
          "kind": "host"
        },
        "other": {
          "kind": "host"
        }
      },
      "actions": {
        "spawn_other": {
          "kind": "spawn_child",
          "src": "other",
          "id": "kid"
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "AGAIN"
          }
        }
      ]
    },
    {
      "name": "sendTo a child by its id and by #_ and its id",
      "test": "actions/send.ts resolveSendTo: a child id, and #_<id>",
      "machine": {
        "id": "m",
        "initial": "a",
        "states": {
          "a": {
            "invoke": {
              "src": "child",
              "id": "kid"
            },
            "on": {
              "PING": {
                "actions": [
                  "send_plain",
                  "send_hash"
                ]
              }
            }
          }
        }
      },
      "actors": {
        "child": {
          "kind": "host"
        }
      },
      "actions": {
        "send_plain": {
          "kind": "send_to",
          "target": "kid",
          "event": {
            "type": "HELLO",
            "n": 1
          }
        },
        "send_hash": {
          "kind": "send_to",
          "target": "#_kid",
          "event": {
            "type": "HELLO",
            "n": 2
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "PING"
          }
        }
      ]
    },
    {
      "name": "sendTo with an id and a delay, by number and by name",
      "test": "actions/send.ts resolveSendTo: params {to, targetId, event, id, delay}",
      "machine": {
        "id": "m",
        "initial": "a",
        "states": {
          "a": {
            "invoke": {
              "src": "child",
              "id": "kid"
            },
            "on": {
              "PING": {
