  "excluded": [
    {
      "test": "actions.test.ts > sendTo, sendParent, forwardTo, stopChild",
      "reason": "deliver events to running children; ported with the actor cases, fixtures/actors/cases/actions.json, test by test: the tests of actions.test.ts's sendTo and forwardTo() are listed there, ported or excluded with their own reasons, except sendTo's self-event handler test, which fixtures/cases/actions.json excludes, as it does sendParent's one test, a TypeScript compile check"
    },
    {
      "test": "a spawnChild without an id",
      "reason": "the difference 'A spawned child without an id' (doc: #differences-spawn-id): XState keys the child \"undefined\" and a stopChild then leaves that key, where xstate's spawn_child_action requires an id, and the vocabulary's spawn_child takes one; it would need xstate to accept a spawnChild without an id and key its child as XState does"
    }
  ]
}
