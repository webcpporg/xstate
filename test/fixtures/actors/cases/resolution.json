        "context": {},
        "entry": [
          "spawn_done"
        ]
      },
      "actions": {
        "spawn_done": {
          "kind": "spawn_child",
          "src": "finished",
          "id": "a",
          "systemId": "x"
        }
      },
      "actors": {
        "finished": {
          "kind": "machine",
          "machine": {
            "initial": "f",
            "states": {
              "f": {
