{
  "source": "the final review of the actor layer, findings 5 and 7, and XState's resolution of spawnChild, stopChild and sendTo (stateUtils.ts resolveActionsAndContext)",
  "cases": [
    {
      "name": "a stop frees a systemId a later invoke of the same macrostep claims, and a send to that invoke reaches it after its start",
      "test": "review of the actor layer, finding 5: XState unregisters a stopped child's systemId while it resolves the stop, before the invoke after it registers the same name",
      "machine": {
        "id": "root",
        "initial": "a",
        "states": {
          "a": {
            "entry": [
              "spawn_y"
            ],
            "on": {
              "GO": "b"
            }
          },
          "b": {
            "entry": [
              "ping_n",
              "stop_y"
            ],
            "invoke": {
              "id": "n",
              "src": "worker",
              "systemId": "svc"
            }
          }
        }
      },
      "actions": {
        "spawn_y": {
          "kind": "spawn_child",
          "src": "worker",
          "id": "y",
          "systemId": "svc"
        },
        "ping_n": {
          "kind": "send_to",
          "target": "n",
          "event": {
            "type": "PING"
          }
        },
        "stop_y": {
          "kind": "stop_child",
          "id": "y"
        }
      },
      "actors": {
        "worker": {
          "kind": "machine",
          "machine": {
            "id": "worker",
            "initial": "idle",
            "states": {
              "idle": {
                "on": {
                  "PING": "heard"
                }
              },
              "heard": {}
            }
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "GO"
          }
        }
      ]
    },
    {
      "name": "a send to a systemId reaches the grandchild a child spawned earlier in the same macrostep constructed",
      "test": "review of the actor layer, finding 7: XState constructs a child, its own initial children included, while it resolves the spawn",
      "machine": {
        "id": "root",
        "initial": "a",
        "states": {
          "a": {
            "on": {
              "GO": "b"
            }
          },
          "b": {
            "invoke": {
              "id": "c",
              "src": "middle"
            },
            "initial": "b1",
            "states": {
              "b1": {
                "entry": [
                  "hello_g"
                ],
                "on": {
                  "HELLO": "b2"
                }
              },
              "b2": {}
            }
          }
        }
      },
      "actions": {
        "hello_g": {
          "kind": "send_to",
          "target": "#system:g",
          "event": {
            "type": "HELLO"
          }
        }
      },
      "actors": {
        "middle": {
          "kind": "machine",
          "machine": {
            "id": "middle",
            "invoke": {
              "id": "g",
              "src": "grand",
              "systemId": "g"
            }
          },
          "actors": {
            "grand": {
              "kind": "machine",
              "machine": {
                "id": "grand",
                "initial": "idle",
                "states": {
                  "idle": {
                    "on": {
                      "HELLO": "heard"
                    }
                  },
                  "heard": {}
                }
              }
            }
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "GO"
          }
        }
      ]
    },
