{
  "source": "actions.test.ts (the tests that need actors)",
  "cases": [
    {
      "name": "an invoked child that starts final runs its own exit actions and the parent completes",
      "test": "actions.test.ts > entry/exit actions > when reaching a final state > exit actions should be called when invoked machine reaches its final state (the two exit spies as pushes into the child's context; the parent's complete observer as its status done)",
      "machine": {
        "initial": "active",
        "states": {
          "active": {
            "invoke": {
              "src": "child",
              "onDone": "finished"
            }
          },
          "finished": {
            "type": "final"
          }
        }
      },
      "actors": {
        "child": {
          "kind": "machine",
          "machine": {
            "context": {
              "log": []
            },
            "exit": [
              {
                "type": "push",
                "params": {
                  "key": "log",
                  "value": "exit child root"
                }
              }
            ],
            "initial": "a",
            "states": {
              "a": {
                "type": "final",
                "exit": [
                  {
                    "type": "push",
                    "params": {
                      "key": "log",
                      "value": "exit a"
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "steps": [
        {
          "start": true
        }
      ]
    },
    {
      "name": "stopping a parent whose child sends from its exit action stops both quietly",
      "test": "actions.test.ts > entry/exit actions > when stopped > stopping an interpreter that receives events from its children exit handlers should not throw (the absence of a throw as both actors stopped and no event processed)",
      "machine": {
        "id": "parent",
        "invoke": {
          "src": "child"
        }
      },
      "actors": {
        "child": {
          "kind": "machine",
          "machine": {
            "id": "child",
            "initial": "idle",
            "states": {
              "idle": {
                "exit": [
                  "sendExit"
                ]
              }
            }
          },
          "actions": {
            "sendExit": {
              "kind": "send_parent",
              "event": {
                "type": "EXIT"
              }
            }
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "stop": true
        }
      ]
    },
    {
      "name": "a done child's exit action reaches its parent",
      "test": "actions.test.ts > entry/exit actions > when stopped > sent events from exit handlers of a done child should be received by the parent  (the child is spawned by a spawnChild in the root's entry under an id and named by it, since a case's context cannot spawn and holds no actor reference; the parent's spy as a push into its context)",
      "machine": {
        "id": "parent",
        "context": {
          "log": []
        },
        "entry": [
          "spawnTheChild"
        ],
        "on": {
          "FINISH_CHILD": {
            "actions": [
              "finishTheChild"
            ]
          },
          "CHILD_DONE": {
            "actions": [
              {
                "type": "push",
                "params": {
                  "key": "log",
                  "value": "CHILD_DONE received"
                }
              }
            ]
          }
        }
      },
      "actions": {
        "spawnTheChild": {
          "kind": "spawn_child",
          "src": "child",
          "id": "child"
        },
        "finishTheChild": {
          "kind": "send_to",
          "target": "child",
          "event": {
            "type": "FINISH"
          }
        }
      },
      "actors": {
        "child": {
          "kind": "machine",
          "machine": {
            "id": "child",
            "initial": "active",
            "states": {
              "active": {
                "on": {
                  "FINISH": "done"
                }
              },
              "done": {
                "type": "final"
              }
            },
            "exit": [
              "sendChildDone"
            ]
          },
          "actions": {
            "sendChildDone": {
              "kind": "send_parent",
              "event": {
                "type": "CHILD_DONE"
              }
            }
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "FINISH_CHILD"
          }
        }
      ]
    },
    {
      "name": "a stopped child runs no exit action, so its own child hears nothing",
      "test": "actions.test.ts > entry/exit actions > when stopped > sent events from exit handlers of a stopped child should not be received by its children (the grandchild's spy as a push into its context)",
      "machine": {
        "id": "parent",
        "initial": "a",
        "states": {
          "a": {
            "invoke": {
              "src": "child"
            },
            "on": {
              "NEXT": "b"
            }
          },
          "b": {}
        }
      },
      "actors": {
        "child": {
          "kind": "machine",
          "machine": {
            "id": "child",
            "invoke": {
              "id": "myChild",
              "src": "grandchild"
            },
            "exit": [
              "tellStopped"
            ]
          },
          "actions": {
            "tellStopped": {
              "kind": "send_to",
              "target": "myChild",
              "event": {
                "type": "STOPPED"
              }
            }
          },
          "actors": {
            "grandchild": {
              "kind": "machine",
              "machine": {
                "id": "grandchild",
                "context": {
                  "log": []
                },
                "on": {
                  "STOPPED": {
                    "actions": [
                      {
                        "type": "push",
                        "params": {
                          "key": "log",
                          "value": "STOPPED received"
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "NEXT"
          }
        }
      ]
    },
    {
      "name": "a root stopped from outside runs no exit action and so spawns nothing",
      "test": "actions.test.ts > entry/exit actions > when stopped > actors spawned in exit handlers of a stopped child should not be started (the spawn is a spawnChild under an id in place of an assign that stores the reference; the throwing entry is the vocabulary's fail)",
      "machine": {
        "id": "parent",
        "context": {},
        "exit": [
          "spawnGrandchild"
        ]
      },
      "actions": {
        "spawnGrandchild": {
          "kind": "spawn_child",
          "src": "grandchild",
          "id": "grandchild"
        }
      },
      "actors": {
        "grandchild": {
          "kind": "machine",
          "machine": {
            "id": "grandchild",
            "entry": [
              {
                "type": "fail"
              }
            ]
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "stop": true
        }
      ]
    },
    {
      "name": "forwardTo hands the event to an invoked child, which answers its parent",
      "test": "actions.test.ts > forwardTo() > should forward an event to a service (the complete observer as the root's status done)",
      "machine": {
        "id": "parent",
        "initial": "first",
        "states": {
          "first": {
            "invoke": {
              "src": "child",
              "id": "myChild"
            },
            "on": {
              "EVENT": {
                "actions": [
                  "forwardToChild"
                ]
              },
              "SUCCESS": "last"
            }
          },
          "last": {
            "type": "final"
          }
        }
      },
      "actions": {
        "forwardToChild": {
          "kind": "forward_to",
          "target": "myChild"
        }
      },
      "actors": {
        "child": {
          "kind": "machine",
          "machine": {
            "id": "child",
            "initial": "active",
            "states": {
              "active": {
                "on": {
                  "EVENT": {
                    "actions": [
                      "sendSuccess"
                    ],
                    "guard": {
                      "type": "event_equals",
                      "params": {
                        "key": "value",
                        "value": 42
                      }
                    }
                  }
                }
              }
            }
          },
          "actions": {
            "sendSuccess": {
              "kind": "send_parent",
              "event": {
                "type": "SUCCESS"
              }
            }
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "EVENT",
            "value": 42
          }
        }
      ]
    },
    {
      "name": "a sendTo by id reaches a child the root's entry spawned",
      "test": "actions.test.ts > sendTo > should be able to send an event to a named actor (the child is spawned by a spawnChild in the root's entry under the same id, since a case's context cannot spawn; the child's resolve as a push into its context)",
      "machine": {
        "entry": [
          "spawnTheChild",
          "sendEvent"
        ]
      },
      "actions": {
        "spawnTheChild": {
          "kind": "spawn_child",
          "src": "childMachine",
          "id": "child"
        },
        "sendEvent": {
          "kind": "send_to",
          "target": "child",
          "event": {
            "type": "EVENT"
          }
        }
      },
      "actors": {
        "childMachine": {
          "kind": "machine",
          "machine": {
            "context": {
              "log": []
            },
            "initial": "waiting",
            "states": {
              "waiting": {
                "on": {
                  "EVENT": {
                    "actions": [
                      {
                        "type": "push",
                        "params": {
                          "key": "log",
                          "value": "EVENT received"
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "steps": [
        {
          "start": true
        }
      ]
    },
    {
      "name": "a delayed sendTo does not reach the spawned child that took a stopped child's id",
      "test": "actions.test.ts > sendTo > should not attempt to deliver a delayed event to the spawned actor's ID that was stopped since the event was scheduled (the two spies as pushes into each child's context; the console.warn about the stopped actor is not ported)",
      "machine": {
        "initial": "a",
        "states": {
          "a": {
            "on": {
              "START": "b"
            }
          },
          "b": {
            "entry": [
              "spawnChild1",
              "pingLater",
              "stopMyChild",
              "spawnChild2"
            ]
          }
        }
      },
      "actions": {
        "spawnChild1": {
          "kind": "spawn_child",
          "src": "child1",
          "id": "myChild"
        },
        "pingLater": {
          "kind": "send_to",
          "target": "myChild",
          "event": {
            "type": "PING"
          },
          "delay": 1
        },
        "stopMyChild": {
          "kind": "stop_child",
          "id": "myChild"
        },
        "spawnChild2": {
          "kind": "spawn_child",
          "src": "child2",
          "id": "myChild"
        }
      },
      "actors": {
        "child1": {
          "kind": "machine",
          "machine": {
            "context": {
              "log": []
            },
            "on": {
              "PING": {
                "actions": [
                  {
                    "type": "push",
                    "params": {
                      "key": "log",
                      "value": "child1 PING"
                    }
                  }
                ]
              }
            }
          }
        },
        "child2": {
          "kind": "machine",
          "machine": {
            "context": {
              "log": []
            },
            "on": {
              "PING": {
                "actions": [
                  {
                    "type": "push",
                    "params": {
                      "key": "log",
                      "value": "child2 PING"
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "START"
          }
        },
        {
          "advance": 10
        }
      ]
    },
    {
