    {
      "name": "the first child cancels only its own delayed event of a shared id",
      "test": "actions.test.ts > cancel > should cancel only the delayed event in the machine that scheduled it when canceling the event with the same ID in the machine that sent it first (the two spies as pushes into each child's context)",
      "machine": {
        "invoke": [
          {
            "id": "foo",
            "src": "foo"
          },
          {
            "id": "bar",
            "src": "bar"
          }
        ],
        "on": {
          "cancelFoo": {
            "actions": [
              "tellCanceller"
            ]
          }
        }
      },
      "actions": {
        "tellCanceller": {
          "kind": "send_to",
          "target": "foo",
          "event": {
            "type": "cancel"
          }
        }
      },
      "actors": {
        "foo": {
          "kind": "machine",
          "machine": {
            "id": "foo",
            "context": {
              "log": []
            },
            "entry": [
              "raiseLater"
            ],
            "on": {
              "event": {
                "actions": [
                  {
                    "type": "push",
                    "params": {
                      "key": "log",
                      "value": "event"
                    }
                  }
                ]
              },
              "cancel": {
                "actions": [
                  "cancelSameId"
                ]
              }
            }
          },
          "actions": {
            "raiseLater": {
              "kind": "raise",
              "event": {
                "type": "event"
              },
              "id": "sameId",
              "delay": 100
            },
            "cancelSameId": {
              "kind": "cancel",
              "id": "sameId"
            }
          }
        },
        "bar": {
          "kind": "machine",
          "machine": {
            "id": "bar",
            "context": {
              "log": []
            },
            "entry": [
              "raiseLater"
            ],
            "on": {
              "event": {
                "actions": [
                  {
                    "type": "push",
                    "params": {
                      "key": "log",
                      "value": "event"
                    }
                  }
                ]
              }
            }
          },
          "actions": {
            "raiseLater": {
              "kind": "raise",
              "event": {
                "type": "event"
              },
              "id": "sameId",
              "delay": 100
            }
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "advance": 50
        },
        {
          "send": {
            "type": "cancelFoo"
          }
        },
        {
          "advance": 55
        }
      ]
    },
