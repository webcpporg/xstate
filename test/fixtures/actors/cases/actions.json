    {
      "name": "a done child's exit sends its own child an event that the grandchild handles before it stops",
      "test": "actions.test.ts > entry/exit actions > when stopped > sent events from exit handlers of a done child should be received by its children (the spy as a push into the grandchild's context)",
      "machine": {
        "id": "parent",
        "invoke": {
          "id": "myChild",
          "src": "child"
        },
        "on": {
          "NEXT": {
            "actions": [
              "finish_child"
            ]
          }
        }
      },
      "actions": {
        "finish_child": {
          "kind": "send_to",
          "target": "myChild",
          "event": {
            "type": "FINISH"
          }
        }
      },
      "actors": {
        "child": {
          "kind": "machine",
          "machine": {
            "id": "child",
            "initial": "a",
            "invoke": {
              "id": "myChild",
              "src": "grandchild"
            },
            "states": {
              "a": {
                "on": {
                  "FINISH": "b"
                }
              },
              "b": {
                "type": "final"
              }
            },
            "exit": [
              "tell_stopped"
            ]
          },
          "actions": {
            "tell_stopped": {
              "kind": "send_to",
              "target": "myChild",
              "event": {
                "type": "STOPPED"
              }
            }
          },
          "actors": {
            "grandchild": {
              "kind": "machine",
              "machine": {
                "id": "grandchild",
                "context": {
                  "log": []
                },
                "on": {
                  "STOPPED": {
                    "actions": [
                      {
                        "type": "push",
                        "params": {
                          "key": "log",
                          "value": "stopped"
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
