        "child": {
          "kind": "machine",
          "machine": {
            "context": {
              "log": []
            },
            "on": {
              "PING": {
                "actions": [
                  {
                    "type": "push",
                    "params": {
                      "key": "log",
                      "value": "PING"
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "START"
          }
        },
        {
          "advance": 10
        }
      ]
    },
