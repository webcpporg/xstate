    {
      "name": "the output of a promise invoked inline is assigned to the context on done",
      "test": "invoke.test.ts > invoke > with promises (Promise) > should assign the resolved data when invoked with a promise factory (the resolved {count: 1} is answered as 1, since set_from_event cannot read event.output.count, so assigning event.output.count is assigning event.output)",
      "machine": {
        "id": "promise",
        "context": {
          "count": 0
        },
        "initial": "pending",
        "states": {
          "pending": {
            "invoke": {
              "src": "promise",
              "onDone": {
                "target": "success",
                "actions": [
                  {
                    "type": "set_from_event",
                    "params": {
                      "key": "count",
                      "from": "output"
                    }
                  }
                ]
              }
            }
          },
          "success": {
            "type": "final"
          }
        }
      },
      "actors": {
        "promise": {
          "kind": "host"
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "resolve": {
            "src": "promise",
            "output": 1
          }
        }
      ]
    },
