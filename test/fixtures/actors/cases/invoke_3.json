    {
      "name": "a promise service invoked on an event gets the context and the event as input and its done finishes the machine",
      "test": "invoke.test.ts > invoke > with promises (Promise) > should be able to specify a Promise as a service (the invoke's input, computed from the context and the entering event, is the value it computes)",
      "machine": {
        "id": "promise",
        "initial": "pending",
        "context": {
          "foo": true
        },
        "states": {
          "pending": {
            "on": {
              "BEGIN": "first"
            }
          },
          "first": {
            "invoke": {
              "src": "somePromise",
              "input": {
                "foo": true,
                "event": {
                  "type": "BEGIN",
                  "payload": true
                }
              },
              "onDone": "last"
            }
          },
          "last": {
            "type": "final"
          }
        }
      },
      "actors": {
        "somePromise": {
          "kind": "host"
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "BEGIN",
            "payload": true
          }
        },
        {
          "resolve": {
            "src": "somePromise"
          }
        }
      ]
    },
    {
      "name": "one promise service invoked in two regions makes two requests, each answered on its own",
      "test": "invoke.test.ts > invoke > with promises (Promise) > should be able to reuse the same promise logic multiple times and create unique promise for each created actor (Math.random() is two distinct numbers the host answers, and its {result: n} is answered as n, since set_from_event cannot read event.output.result)",
      "machine": {
        "context": {
          "result1": null,
          "result2": null
        },
        "initial": "pending",
        "states": {
          "pending": {
            "type": "parallel",
            "states": {
              "state1": {
                "initial": "active",
                "states": {
                  "active": {
                    "invoke": {
                      "src": "getRandomNumber",
                      "onDone": {
                        "target": "success",
                        "actions": [
                          {
                            "type": "set_from_event",
                            "params": {
                              "key": "result1",
                              "from": "output"
                            }
                          }
                        ]
                      }
                    }
                  },
                  "success": {
                    "type": "final"
                  }
                }
              },
              "state2": {
                "initial": "active",
                "states": {
                  "active": {
                    "invoke": {
                      "src": "getRandomNumber",
                      "onDone": {
                        "target": "success",
                        "actions": [
                          {
                            "type": "set_from_event",
                            "params": {
                              "key": "result2",
                              "from": "output"
                            }
                          }
                        ]
                      }
                    }
                  },
                  "success": {
                    "type": "final"
                  }
                }
              }
            },
            "onDone": "done"
          },
          "done": {
            "type": "final"
          }
        }
      },
      "actors": {
        "getRandomNumber": {
          "kind": "host"
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "resolve": {
            "src": "getRandomNumber",
            "output": 0.25
          }
        },
        {
          "resolve": {
            "src": "getRandomNumber",
            "output": 0.75
          }
        }
      ]
    },
    {
      "name": "a promise that settles after its invoking state was left sends its parent nothing",
      "test": "invoke.test.ts > invoke > with promises (Promise) > should not emit onSnapshot if stopped (in part: the stop and the late answer; onSnapshot is left out, as syncSnapshot is not ported (out of scope for the actor layer), and the wildcard that throws on an event with a snapshot pushes every event's type to the log; the promise's 5 ms timer is the late resolve)",
      "machine": {
        "context": {
          "log": []
        },
        "initial": "active",
        "states": {
          "active": {
            "invoke": {
              "src": "promise"
            },
            "on": {
              "deactivate": "inactive"
            }
          },
          "inactive": {
            "on": {
              "*": {
                "actions": [
                  {
                    "type": "push_event",
                    "params": {
                      "key": "log"
