{
  "source": "invoke.test.ts (lines 758 to 1365; each test of the describe `with promises (${type})` is ported once, for Promise and PromiseLike alike, since fromPromise adopts either through Promise.resolve and one host actor stands for both)",
  "cases": [
    {
      "name": "a promise invoked inline resolves and its onDone reaches a final state",
      "test": "invoke.test.ts > invoke > with promises (Promise) > should be invoked with a promise factory and resolve through onDone",
      "machine": {
        "initial": "pending",
        "states": {
          "pending": {
            "invoke": {
              "src": "promise",
              "onDone": "success"
            }
          },
          "success": {
            "type": "final"
          }
        }
      },
      "actors": {
        "promise": {
          "kind": "host"
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "resolve": {
            "src": "promise"
          }
        }
      ]
    },
    {
      "name": "a promise given the context as input rejects and its onError reaches a final state",
      "test": "invoke.test.ts > invoke > with promises (Promise) > should be invoked with a promise factory and reject with ErrorExecution (the context, defaults merged with the input, is the input's two members; the invoke's input, the context, is the value it computes; onDone's guard, event.output === context.id, is event_equals on that id)",
      "machine": {
        "id": "invokePromise",
        "initial": "pending",
        "states": {
          "pending": {
            "invoke": {
              "src": "promise",
              "input": {
                "id": 31,
                "succeed": false
              },
              "onDone": {
                "target": "success",
                "guard": {
                  "type": "event_equals",
                  "params": {
                    "key": "output",
                    "value": 31
                  }
                }
              },
              "onError": "failure"
            }
          },
          "success": {
            "type": "final"
          },
          "failure": {
            "type": "final"
          }
        }
      },
      "context_from_input": {
        "id": "id",
        "succeed": "succeed"
      },
      "actors": {
        "promise": {
          "kind": "host"
        }
      },
      "steps": [
        {
          "start": true,
          "input": {
            "id": 31,
            "succeed": false
          }
        },
        {
          "reject": {
            "src": "promise",
            "error": {
              "message": "failed on purpose for: 31"
            }
          }
        }
      ]
    },
    {
      "name": "a promise that rejects with no onError fails its parent with the error",
