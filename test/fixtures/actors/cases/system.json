{
  "source": "system.test.ts",
  "cases": [
    {
      "name": "an invoked actor's systemId lets a sibling's initial entry reach it",
      "test": "system.test.ts > system > should register an invoked actor (the receiver is a machine actor in place of the callback, and the sibling's entry action is a sendTo to the systemId in place of a custom action calling system.get)",
      "machine": {
        "id": "parent",
        "initial": "a",
        "states": {
          "a": {
            "invoke": [
              {
                "src": "receiver",
                "systemId": "receiver"
              },
              {
                "src": "childmachine"
              }
            ]
          }
        }
      },
      "actors": {
        "receiver": {
          "kind": "machine",
          "machine": {
            "id": "receiver",
            "context": {
              "log": []
            },
            "on": {
              "HELLO": {
                "actions": [
                  {
                    "type": "push_event",
                    "params": {
                      "key": "log"
                    }
                  }
                ]
              }
            }
          }
        },
        "childmachine": {
          "kind": "machine",
          "machine": {
            "id": "childmachine",
            "context": {
              "log": []
            },
            "entry": [
              "hello"
            ],
            "on": {
              "HELLO": {
                "actions": [
                  {
                    "type": "push_event",
                    "params": {
                      "key": "log"
                    }
                  }
                ]
              }
            }
          },
          "actions": {
            "hello": {
              "kind": "send_to",
              "target": "#system:receiver",
              "event": {
                "type": "HELLO"
              }
            }
          }
        }
      },
      "steps": [
        {
          "start": true
        }
      ]
    },
    {
      "name": "a spawned actor's systemId lets a machine spawned later reach it from its initial entry",
      "test": "system.test.ts > system > should register a spawned actor (the receiver is a machine actor in place of the callback, spawned with an id by the root's entry in place of its context function; the child's entry action is a sendTo to the systemId in place of a custom action calling system.get)",
