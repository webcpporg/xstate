          "kind": "spawn_child",
          "src": "receiver",
          "id": "receiver",
          "systemId": "receiver"
        },
        "spawn_childmachine": {
          "kind": "spawn_child",
          "src": "childmachine",
          "id": "childmachine"
        }
      },
      "actors": {
        "receiver": {
          "kind": "machine",
          "machine": {
            "id": "receiver",
            "context": {
              "log": []
            },
            "on": {
              "HELLO": {
                "actions": [
                  {
                    "type": "push_event",
                    "params": {
                      "key": "log"
                    }
                  }
                ]
              }
            }
          }
        },
        "childmachine": {
          "kind": "machine",
          "machine": {
            "id": "childmachine",
            "context": {
              "log": []
            },
            "entry": [
              "hello"
            ],
            "on": {
              "HELLO": {
                "actions": [
                  {
                    "type": "push_event",
                    "params": {
                      "key": "log"
                    }
                  }
                ]
              }
            }
          },
          "actions": {
            "hello": {
              "kind": "send_to",
              "target": "#system:receiver",
              "event": {
                "type": "HELLO"
              }
            }
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "toggle"
          }
        }
      ]
    },
