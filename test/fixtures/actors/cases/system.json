    {
      "name": "a reentered state's new invoke holds the systemId its old one released",
      "test": "system.test.ts > system > should gracefully handle re-registration of a `systemId` during a reentering transition (the listener is a machine actor in place of the callback, and the event goes through the root's sendTo to the systemId, where the test sends it from outside through system.get; a first 'a' before RESTART gives the old listener a log the new one does not have, so the last step's log shows which of the two received 'a')",
      "machine": {
        "context": {
          "log": []
        },
        "initial": "listening",
        "states": {
          "listening": {
            "invoke": {
              "systemId": "listener",
              "src": "listener"
            }
          }
        },
        "on": {
          "RESTART": {
            "target": ".listening"
          },
          "SEND_A": {
            "actions": [
              "send_a"
