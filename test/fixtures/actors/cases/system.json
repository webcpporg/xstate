    {
      "name": "an actor invoked under a systemId fails when its own invoke claims that systemId",
      "test": "system.test.ts > system > should throw an error if an actor with the system ID already exists (the test's machine runs as an actor invoked under that systemId by a root that only invokes it: the start step cannot give the root a systemId; the error's message is not recorded)",
      "machine": {
        "invoke": {
          "src": "machine",
          "id": "machine",
          "systemId": "test"
        }
      },
      "actors": {
        "machine": {
          "kind": "machine",
          "machine": {
            "initial": "inactive",
            "states": {
              "inactive": {
                "on": {
                  "toggle": "active"
                }
              },
              "active": {
                "invoke": [
                  {
                    "src": "first",
                    "systemId": "test"
                  },
                  {
                    "src": "second",
                    "systemId": "test"
                  }
                ]
              }
            }
          },
          "actors": {
            "first": {
              "kind": "machine",
              "machine": {}
            },
            "second": {
              "kind": "machine",
              "machine": {}
            }
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "toggle"
          },
          "to": "root/machine"
        }
      ]
    },
