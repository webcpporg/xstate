          },
          "a": {
            "actions": [
              {
                "type": "push_event",
                "params": {
                  "key": "log"
                }
              }
            ]
          }
        }
      },
      "actions": {
        "send_a": {
          "kind": "send_to",
          "target": "#system:listener",
          "event": {
            "type": "a"
          }
        }
      },
      "actors": {
        "listener": {
          "kind": "machine",
          "machine": {
            "id": "listener",
            "context": {
              "log": []
            },
            "on": {
              "a": {
                "actions": [
                  {
                    "type": "push_event",
                    "params": {
                      "key": "log"
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "SEND_A"
          }
        },
        {
          "send": {
            "type": "RESTART"
          }
        },
        {
          "send": {
            "type": "SEND_A"
          }
        }
      ]
    },
