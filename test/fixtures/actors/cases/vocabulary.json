    {
      "name": "set_from_event copies a member that is null",
      "test": "review of the actor layer, finding 33: assign({[key]: event[from]}) sets the key to null",
      "machine": {
        "id": "root",
        "context": {
          "k": 1
        },
        "on": {
          "E": {
            "actions": [
              {
                "type": "set_from_event",
                "params": {
                  "key": "k",
                  "from": "v"
                }
              }
            ]
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "E",
            "v": null
          }
        }
      ]
    },
    {
      "name": "host requests are listed and answered in the order of their actors' keys, whatever their depth",
      "test": "review of the actor layer, finding 30: a request is named by src as the pending one whose actor's key comes first, an order no nesting of deliveries changes",
      "machine": {
        "id": "root",
        "entry": [
          "spawn_a",
          "spawn_m",
          "spawn_c"
        ]
      },
      "actions": {
        "spawn_a": {
          "kind": "spawn_child",
          "src": "fetch",
          "id": "a"
        },
        "spawn_m": {
          "kind": "spawn_child",
          "src": "m",
          "id": "m"
        },
        "spawn_c": {
          "kind": "spawn_child",
          "src": "fetch",
          "id": "c"
        }
      },
      "actors": {
        "fetch": {
          "kind": "host"
        },
        "m": {
          "kind": "machine",
          "machine": {
            "id": "m",
            "entry": [
              "spawn_b"
            ]
          },
          "actions": {
            "spawn_b": {
              "kind": "spawn_child",
              "src": "fetch",
              "id": "b"
            }
          },
          "actors": {
            "fetch": {
              "kind": "host"
            }
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "resolve": {
            "src": "fetch",
            "output": 1
          }
        },
        {
          "resolve": {
            "src": "fetch",
            "output": 2
          }
        },
        {
          "resolve": {
            "src": "fetch",
            "output": 3
          }
        }
      ]
    },
    {
      "name": "requests whose actors nested deliveries create in another order are listed and answered by key",
      "machine": {
        "id": "root",
        "invoke": [
          {
            "src": "relay",
            "id": "a"
          },
          {
            "src": "worker",
            "id": "b"
          }
        ],
        "on": {
          "GO": {
            "actions": [
              "ping_a",
              "ping_b"
            ]
          }
        }
      },
      "actions": {
        "ping_a": {
          "kind": "send_to",
          "target": "a",
          "event": {
            "type": "PING"
          }
        },
        "ping_b": {
          "kind": "send_to",
          "target": "b",
          "event": {
            "type": "PING"
          }
        }
      },
      "actors": {
        "relay": {
          "kind": "machine",
          "machine": {
            "id": "relay",
            "invoke": {
              "src": "worker",
              "id": "x"
            },
            "on": {
              "PING": {
                "actions": [
                  "ping_x"
                ]
              }
            }
          },
          "actions": {
            "ping_x": {
              "kind": "send_to",
              "target": "x",
              "event": {
                "type": "PING"
              }
            }
          },
          "actors": {
            "worker": {
              "kind": "machine",
              "machine": {
                "id": "worker",
                "initial": "idle",
                "states": {
                  "idle": {
                    "on": {
                      "PING": "busy"
                    }
                  },
                  "busy": {
                    "invoke": {
                      "src": "job",
                      "id": "job",
                      "onDone": "done"
                    }
                  },
                  "done": {
                    "type": "final"
                  }
                }
              },
              "actors": {
                "job": {
                  "kind": "host"
                }
              }
            }
          }
        },
        "worker": {
          "kind": "machine",
          "machine": {
            "id": "worker",
            "initial": "idle",
            "states": {
              "idle": {
                "on": {
                  "PING": "busy"
                }
              },
              "busy": {
                "invoke": {
                  "src": "job",
                  "id": "job",
                  "onDone": "done"
                }
              },
              "done": {
                "type": "final"
              }
            }
          },
          "actors": {
            "job": {
              "kind": "host"
            }
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "GO"
          }
        },
        {
          "resolve": {
            "src": "job",
            "output": 1
          }
        },
        {
          "resolve": {
            "src": "job",
            "output": 2
          }
        }
      ],
      "test": "review of the cases' oracle: XState delivers a send to an idle actor nested in its sender and xactor queues it, so the jobs are created in another order; their keys are not"
    },
