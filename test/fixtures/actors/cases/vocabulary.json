{
  "source": "the cases' own vocabulary and oracle, against XState: findings 30 to 33 of the review of the actor layer",
  "cases": [
    {
      "name": "a guard that fails in a child reaches its parent as implementation_failed",
      "test": "review of the actor layer, finding 31: XState wraps a guard's error as 'Unable to evaluate guard ...', which the oracle writes as the code xstate gives",
      "machine": {
        "id": "root",
        "context": {},
        "invoke": {
          "src": "picky",
          "id": "kid",
          "onError": {
            "actions": [
              {
                "type": "set_from_event",
                "params": {
                  "key": "reason",
                  "from": "error"
                }
              }
            ]
          }
        }
      },
      "actors": {
        "picky": {
          "kind": "machine",
          "machine": {
            "id": "picky",
            "on": {
              "GO": {
                "guard": "fail",
                "actions": []
              }
            }
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "GO"
          },
          "to": "root/kid"
        }
      ]
    },
