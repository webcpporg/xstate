    {
      "name": "context_equals compares as JSON.stringify writes: 1 and 1.0 alike, key order and null against a missing key told apart",
      "machine": {
        "id": "root",
        "context": {
          "n": 1,
          "o": {
            "a": 1,
            "b": 2
          },
          "z": null
        },
        "initial": "s",
        "states": {
          "s": {
            "on": {
              "INT": {
                "guard": {
                  "type": "context_equals",
                  "params": {
                    "key": "n",
                    "value": 1.0
                  }
                },
                "actions": [
                  {
                    "type": "set",
                    "params": {
                      "key": "int",
                      "value": true
                    }
                  }
                ]
              },
              "ORDER": {
                "guard": {
                  "type": "context_equals",
                  "params": {
                    "key": "o",
                    "value": {
                      "b": 2,
                      "a": 1
                    }
                  }
                },
                "actions": [
                  {
                    "type": "set",
                    "params": {
                      "key": "order",
                      "value": true
                    }
                  }
                ]
              },
              "NULL": {
                "guard": {
                  "type": "context_equals",
                  "params": {
                    "key": "missing",
                    "value": null
                  }
                },
                "actions": [
                  {
                    "type": "set",
                    "params": {
                      "key": "null",
                      "value": true
                    }
                  }
                ]
              },
              "BOTH": {
                "guard": {
                  "type": "context_equals",
                  "params": {
                    "key": "missing"
                  }
                },
                "actions": [
                  {
                    "type": "set",
                    "params": {
                      "key": "both",
                      "value": true
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "INT"
          }
        },
        {
          "send": {
            "type": "ORDER"
          }
        },
        {
          "send": {
            "type": "NULL"
          }
        },
        {
          "send": {
            "type": "BOTH"
          }
        }
      ],
      "test": "review of the cases' vocabulary and oracle: the vocabulary is strict and both of its tables define the same functions"
    },
