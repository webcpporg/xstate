{
  "source": "the reviews of xstate: what XState's actors do where its own tests are silent",
  "cases": [
    {
      "name": "a root that is a history node is in error once started",
      "test": "createActor's _initState catches the throw of a machine whose root is a history node, and the actor is in error from its construction",
      "machine": {
        "type": "history"
      },
      "steps": [
        {
          "start": true
        }
      ]
    },
    {
      "name": "a child whose root is a history node fails its parent's invoke",
      "test": "createActor's _initState catches the throw of a machine whose root is a history node, and the actor is in error from its construction",
      "machine": {
        "initial": "a",
        "states": {
          "a": {
            "invoke": {
              "src": "broken",
              "id": "kid",
              "onError": "failed"
            }
          },
          "failed": {}
        }
      },
      "actors": {
        "broken": {
          "kind": "machine",
          "machine": {
            "type": "history",
            "target": "x"
          }
        }
      },
      "steps": [
        {
          "start": true
        }
      ]
    },
    {
      "name": "a sendTo of an event of type '*' fails the child that takes it",
      "test": "XState's development build refuses an event of type '*' only where a macrostep takes it from outside (stateUtils.ts macrostep): a sendTo or a delayed raise carries it, and the actor that takes it fails",
      "machine": {
        "initial": "a",
        "states": {
          "a": {
            "invoke": {
              "src": "kid",
              "id": "k",
              "onError": "failed"
            },
            "on": {
              "GO": {
                "actions": [
                  "send_star"
                ]
              }
            }
          },
          "failed": {}
        }
      },
      "actions": {
        "send_star": {
          "kind": "send_to",
          "target": "k",
          "event": {
            "type": "*"
          }
        }
      },
      "actors": {
        "kid": {
          "kind": "machine",
          "machine": {
            "context": {},
            "on": {
              "*": {
                "actions": [
                  {
                    "type": "set",
                    "params": {
                      "key": "got",
                      "value": true
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "GO"
          }
        }
      ]
    },
    {
      "name": "a delayed raise of an event of type '*' fails the actor when it fires",
      "test": "XState's development build refuses an event of type '*' only where a macrostep takes it from outside (stateUtils.ts macrostep): a sendTo or a delayed raise carries it, and the actor that takes it fails",
      "machine": {
        "on": {
          "GO": {
            "actions": [
              "raise_star_later"
            ]
          }
        }
      },
      "actions": {
        "raise_star_later": {
          "kind": "raise",
          "event": {
            "type": "*"
          },
          "delay": 100
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "GO"
          }
        },
        {
          "advance": 50
        },
        {
          "advance": 50
        }
      ]
    },
    {
      "name": "a delayed raise of an event of type '*' cancelled before it fires changes nothing",
      "test": "XState's development build refuses an event of type '*' only where a macrostep takes it from outside (stateUtils.ts macrostep): a sendTo or a delayed raise carries it, and the actor that takes it fails",
      "machine": {
        "on": {
          "GO": {
            "actions": [
              "raise_star_later"
            ]
          },
          "STOP": {
            "actions": [
              "cancel_star"
            ]
          }
        }
      },
      "actions": {
        "raise_star_later": {
          "kind": "raise",
          "event": {
            "type": "*"
          },
          "id": "t",
          "delay": 100
        },
        "cancel_star": {
          "kind": "cancel",
          "id": "t"
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "GO"
          }
        },
        {
          "send": {
            "type": "STOP"
          }
        },
        {
          "advance": 200
        }
      ]
    },
    {
      "name": "a raised event of type '*' takes the wildcard transition of an actor",
      "test": "XState's development build refuses an event of type '*' only where a macrostep takes it from outside (stateUtils.ts macrostep): a sendTo or a delayed raise carries it, and the actor that takes it fails",
      "machine": {
        "initial": "a",
        "states": {
          "a": {
            "on": {
              "GO": {
                "actions": [
                  "raise_star"
                ]
              },
              "*": "b"
            }
          },
          "b": {}
        }
      },
      "actions": {
        "raise_star": {
          "kind": "raise",
          "event": {
            "type": "*"
          }
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "GO"
          }
        }
      ]
    },
    {
      "name": "an active child's start claims nothing, though another actor took its systemId while it waited for a construction",
      "machine": {
        "context": {},
        "initial": "s",
        "states": {
          "s": {
            "invoke": [
              {
                "src": "p",
                "id": "p"
              },
              {
                "src": "m",
                "id": "m"
              }
            ],
            "on": {
              "GO": {
                "actions": [
                  "go_p",
                  "ping_m"
                ]
              },
              "RESTART": "t"
            }
          },
          "t": {
            "invoke": {
              "src": "k",
              "id": "k",
              "systemId": "x"
            }
          }
        }
      },
      "actions": {
        "go_p": {
          "kind": "send_to",
          "target": "p",
          "event": {
            "type": "GO"
          }
        },
        "ping_m": {
          "kind": "send_to",
          "target": "m",
          "event": {
            "type": "PING"
          }
        }
      },
      "actors": {
        "p": {
          "kind": "machine",
          "machine": {
            "initial": "idle",
            "states": {
              "idle": {
                "on": {
                  "GO": "busy"
                }
              },
              "busy": {
                "invoke": {
                  "src": "c",
                  "id": "c",
                  "systemId": "x"
                }
              }
            }
          },
          "actors": {
            "c": {
              "kind": "machine",
              "machine": {}
            }
          }
        },
        "m": {
          "kind": "machine",
          "machine": {
            "context": {},
            "on": {
              "PING": {
                "actions": [
                  "restart"
                ]
              }
            }
          },
          "actions": {
            "restart": {
              "kind": "send_parent",
              "event": {
                "type": "RESTART"
              }
            }
          }
        },
        "k": {
          "kind": "machine",
          "machine": {}
        }
      },
      "steps": [
        {
          "start": true
        },
        {
          "send": {
            "type": "GO"
          }
        },
        {
          "get": "x"
        }
      ],
      "test": "createActor.ts start(): system._set claims the systemId again only for a child the constructor released, and within the parent's own macrostep, which XState runs whole"
    },
