        {
          "send": {
            "type": "CANCEL"
          }
        },
        {
          "advance": 300
        }
      ],
      "test": "system.ts scheduler: schedule keeps an earlier timeout under the same id in the clock, timerMap names the later, and any of them deletes timerMap's entry when it fires",
      "machine": {
        "context": {
          "log": []
        },
        "entry": [
          "a_later",
          "b_later"
        ],
        "on": {
          "A": {
            "actions": [
              {
                "type": "push",
                "params": {
                  "key": "log",
                  "value": "a"
                }
              }
            ]
          },
          "B": {
            "actions": [
              {
                "type": "push",
                "params": {
                  "key": "log",
                  "value": "b"
                }
              }
            ]
          },
          "CANCEL": {
            "actions": [
              "cancel_t"
            ]
          }
        }
      },
      "actions": {
        "a_later": {
          "kind": "raise",
          "event": {
            "type": "A"
          },
          "id": "t",
          "delay": 100
        },
        "b_later": {
          "kind": "raise",
          "event": {
            "type": "B"
          },
          "id": "t",
          "delay": 200
        },
        "cancel_t": {
          "kind": "cancel",
          "id": "t"
        }
      }
    },
