{
  "source": "actions.test.ts (the tests that need actors)",
  "cases": [
    {
      "name": "an invoked child that starts final runs its own exit actions and the parent completes",
      "steps": [
        {
          "actors": {
            "root/0.(machine).active": {
              "events": [
                {
                  "event": {
                    "type": "xstate.init"
                  },
                  "snapshot": {
                    "value": "a",
                    "context": {
                      "log": [
                        "exit a",
                        "exit child root"
                      ]
                    },
                    "status": "done",
                    "tags": [],
                    "nodes": [
                      "(machine).a",
                      "(machine)"
                    ]
                  }
                }
              ],
              "emitted": []
            },
            "root": {
              "events": [
                {
                  "event": {
                    "type": "xstate.init"
                  },
                  "snapshot": {
                    "value": "active",
                    "context": {},
                    "status": "active",
                    "tags": [],
                    "nodes": [
                      "(machine)",
                      "(machine).active"
                    ],
                    "children": {
                      "0.(machine).active": "child"
                    }
                  }
                },
                {
                  "event": {
                    "type": "xstate.done.actor.0.(machine).active",
                    "actorId": "0.(machine).active"
                  },
                  "snapshot": {
                    "value": "finished",
                    "context": {},
                    "status": "done",
                    "tags": [],
                    "nodes": [
                      "(machine).finished",
                      "(machine)"
                    ]
                  }
                }
              ],
              "emitted": []
            }
          },
          "statuses": {
            "root": "done",
            "root/0.(machine).active": "done"
          },
          "requests": []
        }
      ]
    },
