    {
      "name": "a rejected host request takes onError",
      "steps": [
        {
          "actors": {
            "root": {
              "events": [
                {
                  "event": {
                    "type": "xstate.init"
                  },
                  "snapshot": {
                    "value": "loading",
                    "context": {},
                    "status": "active",
                    "tags": [],
                    "nodes": [
                      "app",
                      "app.loading"
                    ],
