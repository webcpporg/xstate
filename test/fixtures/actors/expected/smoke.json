{
  "source": "smoke",
  "cases": [
    {
      "name": "a parent invokes a child machine and a host actor",
      "steps": [
        {
          "actors": {
            "root": {
              "events": [
                {
                  "event": {
                    "type": "xstate.init"
                  },
                  "snapshot": {
                    "value": "loading",
                    "context": {},
                    "status": "active",
                    "tags": [],
                    "nodes": [
                      "app",
                      "app.loading"
                    ],
                    "children": {
                      "fetch": "fetchUser"
                    }
                  }
                }
              ],
              "emitted": []
            }
          },
          "statuses": {
            "root": "active",
            "root/fetch": "active"
          },
          "requests": [
            {
              "actor": "root/fetch",
              "src": "fetchUser",
              "input": {
                "userId": 42
              }
            }
          ]
        },
        {
          "actors": {
            "root/counter": {
              "events": [
                {
                  "event": {
                    "type": "xstate.init"
                  },
                  "snapshot": {
                    "value": "counting",
                    "context": {
                      "count": 0
                    },
                    "status": "active",
                    "tags": [],
                    "nodes": [
                      "counter",
                      "counter.counting"
                    ]
                  }
                }
              ],
              "emitted": []
            },
            "root": {
              "events": [
                {
                  "event": {
                    "type": "xstate.done.actor.fetch",
                    "output": {
                      "name": "ana"
                    },
                    "actorId": "fetch"
                  },
                  "snapshot": {
                    "value": "ready",
                    "context": {
                      "user": {
                        "name": "ana"
                      }
                    },
                    "status": "active",
                    "tags": [],
                    "nodes": [
                      "app",
                      "app.ready"
                    ],
                    "children": {
                      "counter": "counter"
                    }
                  }
                }
              ],
              "emitted": []
            }
          },
          "statuses": {
            "root": "active",
            "root/fetch": "done",
            "root/counter": "active"
          },
          "requests": []
        },
        {
          "actors": {
            "root/counter": {
              "events": [
                {
                  "event": {
                    "type": "TICK"
                  },
                  "snapshot": {
                    "value": "counting",
                    "context": {
                      "count": 1
                    },
                    "status": "active",
                    "tags": [],
                    "nodes": [
                      "counter",
                      "counter.counting"
                    ]
                  }
                }
              ],
              "emitted": []
            }
          },
          "statuses": {
            "root": "active",
            "root/fetch": "done",
            "root/counter": "active"
          },
          "requests": []
        },
        {
          "actors": {
            "root/counter": {
              "events": [
                {
                  "event": {
                    "type": "TICK"
                  },
                  "snapshot": {
                    "value": "counting",
                    "context": {
                      "count": 2
                    },
                    "status": "active",
                    "tags": [],
                    "nodes": [
                      "counter",
                      "counter.counting"
                    ]
                  }
                }
              ],
              "emitted": []
            }
          },
          "statuses": {
            "root": "active",
            "root/fetch": "done",
            "root/counter": "active"
          },
          "requests": []
        },
        {
          "actors": {
            "root": {
              "events": [
                {
                  "event": {
                    "type": "xstate.done.actor.counter",
                    "output": {
                      "done": true
                    },
                    "actorId": "counter"
                  },
                  "snapshot": {
                    "value": "finished",
                    "context": {
                      "user": {
                        "name": "ana"
                      },
                      "counted": {
                        "done": true
                      }
                    },
                    "status": "done",
                    "tags": [],
                    "nodes": [
                      "app.finished",
                      "app"
                    ]
                  }
                }
              ],
              "emitted": []
            },
            "root/counter": {
              "events": [
                {
                  "event": {
                    "type": "STOP"
                  },
                  "snapshot": {
                    "value": "stopped",
                    "context": {
                      "count": 2
                    },
                    "status": "done",
                    "tags": [],
                    "nodes": [
                      "counter.stopped",
                      "counter"
                    ],
                    "output": {
                      "done": true
                    }
                  }
                }
              ],
              "emitted": []
            }
          },
          "statuses": {
            "root": "done",
            "root/fetch": "done",
            "root/counter": "done"
          },
          "requests": []
        }
      ]
    },
    {
