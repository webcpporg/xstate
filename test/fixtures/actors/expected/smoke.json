                  "snapshot": {
                    "value": "failed",
                    "context": {
                      "reason": {
                        "message": "boom"
                      }
                    },
                    "status": "active",
                    "tags": [],
                    "nodes": [
                      "app",
                      "app.failed"
                    ]
                  }
                }
              ],
              "emitted": []
            }
          },
          "statuses": {
            "root": "active",
            "root/fetch": "error"
          },
          "requests": []
        }
      ]
