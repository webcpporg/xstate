          "requests": []
        },
        {
          "actors": {
            "root": {
              "events": [
                {
                  "event": {
                    "type": "xstate.done.actor.sleeper",
                    "actorId": "sleeper"
                  },
                  "snapshot": {
                    "value": "woken",
                    "context": {},
                    "status": "active",
                    "tags": [],
                    "nodes": [
                      "parent",
                      "parent.woken"
                    ]
                  }
                }
              ],
              "emitted": []
            },
            "root/sleeper": {
              "events": [
                {
                  "event": {
                    "type": "xstate.after.100.sleeper.asleep"
                  },
                  "snapshot": {
                    "value": "awake",
                    "context": {},
                    "status": "done",
                    "tags": [],
                    "nodes": [
                      "sleeper.awake",
                      "sleeper"
                    ]
                  }
                }
              ],
              "emitted": []
            }
          },
          "statuses": {
            "root": "active",
            "root/sleeper": "done"
          },
          "requests": []
        }
      ]
