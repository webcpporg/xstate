          "statuses": {
            "root": "active",
            "root/fetch": "active"
          },
          "requests": [
            {
              "actor": "root/fetch",
              "src": "fetchUser"
            }
          ]
        },
        {
          "actors": {
            "root": {
              "events": [
                {
                  "event": {
                    "type": "xstate.error.actor.fetch",
                    "error": {
                      "message": "boom"
