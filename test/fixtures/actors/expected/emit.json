{
  "source": "emit.test.ts",
  "cases": [
    {
      "name": "an event's emit reaches the actor's listeners with its members",
      "steps": [
        {
          "actors": {
            "root": {
              "events": [
                {
                  "event": {
                    "type": "xstate.init"
                  },
                  "snapshot": {
                    "value": {},
                    "context": {},
                    "status": "active",
                    "tags": [],
                    "nodes": [
                      "(machine)"
                    ]
                  }
                }
              ],
              "emitted": []
            }
          },
          "statuses": {
            "root": "active"
          },
          "requests": []
        },
        {
          "actors": {
            "root": {
              "events": [
                {
                  "event": {
                    "type": "someEvent"
                  },
                  "snapshot": {
                    "value": {},
                    "context": {},
                    "status": "active",
                    "tags": [],
                    "nodes": [
                      "(machine)"
                    ]
                  }
                }
              ],
              "emitted": [
                {
                  "type": "emitted",
                  "foo": "bar"
                }
              ]
            }
          },
          "statuses": {
            "root": "active"
          },
          "requests": []
        }
      ]
    },
