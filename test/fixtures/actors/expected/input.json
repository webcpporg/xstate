    {
      "name": "a host actor receives its input and is done with the output it is answered",
      "steps": [
        {
          "actors": {
            "root": {
              "events": [
                {
                  "event": {
                    "type": "xstate.init"
                  },
                  "snapshot": {
                    "value": {},
                    "context": {},
                    "status": "active",
                    "tags": [],
                    "nodes": [
                      "(machine)"
                    ],
                    "children": {
                      "promise": "promiseLogic"
                    }
                  }
                }
              ],
              "emitted": []
            }
          },
          "statuses": {
            "root": "active",
            "root/promise": "active"
          },
          "requests": [
            {
              "actor": "root/promise",
              "src": "promiseLogic",
              "input": {
                "count": 42
              }
            }
          ]
        },
        {
          "actors": {
            "root": {
              "events": [
                {
                  "event": {
                    "type": "xstate.done.actor.promise",
                    "output": {
                      "count": 42
                    },
                    "actorId": "promise"
                  },
                  "snapshot": {
                    "value": {},
                    "context": {
                      "output": {
                        "count": 42
                      }
                    },
                    "status": "active",
                    "tags": [],
                    "nodes": [
                      "(machine)"
                    ],
                    "children": {
                      "promise": "promiseLogic"
                    }
                  }
                }
              ],
              "emitted": []
            }
          },
          "statuses": {
            "root": "active",
            "root/promise": "done"
          },
          "requests": []
        }
      ]
    },
